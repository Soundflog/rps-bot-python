@startuml
skinparam dpi 150
skinparam linetype ortho

[*] --> С

' Ветка: вика
С --> Ь : В, П, К, Я
Ь --> Ъ : И, А, О, К
Ъ --> Э : К, Т, С, Т, О

Э --> Й : А, Я, В
Э --> Ю : А, Т

Ю --> Ц : О
Ц --> Й : Р


Й --> вика

' Ветка: витя

Й --> витя

' Ветка: вася

Й --> вася

' Ветка: потап

Й --> потап

' Ветка: костя

Й --> костя

' Ветка: яков

Й --> яков

' Ветка: виктор

Й --> виктор

' Финальные узлы
вика --> [*]
витя --> [*]
вася --> [*]
потап --> [*]
костя --> [*]
яков --> [*]
виктор --> [*]

