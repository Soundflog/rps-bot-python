@startuml
skinparam dpi 150
skinparam linetype ortho

[*] --> С

' Ветка: вика
С --> вЬ
вЬ --> виЪ
виЪ --> викЭ
викЭ ----> викаЙ
викаЙ --> вика

' Ветка: витя
С --> вЬ
вЬ --> виЪ
виЪ --> витЭ
витЭ ----> витяЙ
витяЙ --> витя

' Ветка: вася
С --> вЬ
вЬ --> ваЬ
ваЬ --> васЭ
васЭ ----> васяЙ
васяЙ --> вася

' Ветка: потап
С --> пЬ
пЬ --> поЬ
поЬ --> потЭ
потЭ --> потаЮ
потаЮ ---> потапЙ
потапЙ --> потап

' Ветка: костя
С --> кЬ
кЬ --> коЪ
коЪ --> косЭ
косЭ --> костЮ
костЮ ---> костяЙ
костяЙ --> костя

' Ветка: яков
С --> яЬ
яЬ --> якЪ
якЪ --> якоЬ
якоЬ ----> яковЙ
яковЙ --> яков

' Ветка: виктор
С --> вЬ
вЬ --> виЪ
виЪ --> викЭ
викЭ --> виктЮ
виктЮ --> виктоЦ
виктоЦ --> викторЙ
викторЙ --> виктор

' Финальные узлы
вика --> [*]
витя --> [*]
вася --> [*]
потап --> [*]
костя --> [*]
яков --> [*]
виктор --> [*]

@enduml
